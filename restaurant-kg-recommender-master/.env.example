DATA_ROOT=./Utils

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

QDRANT_HOST=localhost
QDRANT_PORT=6333
RECREATE_QDRANT=true

EMBED_MODEL=bkai-foundation-models/vietnamese-bi-encoder
ASPECT_SENTIMENT_MODEL=wonrax/phobert-base-vietnamese-sentiment
ASPECT_SENTIMENT_BACKEND=llm
LLM_ASPECT_MODEL_ID=gpt-4o-mini
USE_LLM_GRAPH_EXTRACTION=false
LLM_GRAPH_EXTRACTION_MODEL_ID=gpt-4o-mini
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
USE_CROSS_ENCODER=true
CROSS_ENCODER_WEIGHT=0.30

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

USER_LAT=21.005
USER_LNG=105.843
MAX_DISTANCE_KM=3
DISTANCE_WEIGHT=0.20
DISTANCE_DECAY_KM=3

SIMILARITY_TOP_K=8
SIMILARITY_MIN_SCORE=0.62
RUN_COMMUNITY_REPORTS=true

CACHE_DIR=.cache/graphrag
OBSERVABILITY_LOG_PATH=logs/retrieval_traces.jsonl
